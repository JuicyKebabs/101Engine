#pragma once

// CMake embeds source into the Renderer DLL; runtime asset paths are irrelevant
// to its private display/shadow infrastructure. User bytecode is still explicit.
namespace rendering::detail
{
inline constexpr char BuiltinMeshShader[] = R"HLSL(@BUILTIN_MESH@)HLSL";
inline constexpr char BuiltinFullscreenShader[] = R"HLSL(@BUILTIN_FULLSCREEN@)HLSL";
inline constexpr char BuiltinDisplayShader[] = R"HLSL(@BUILTIN_DISPLAY@)HLSL";
}
